# Скопируйте этот файл в .env и укажите свой ключ OpenAI API.
OPENAI_API_KEY=

# Голосовое демо Telegram: токен, выданный @BotFather командой /newbot.
TELEGRAM_BOT_TOKEN=
# Необязательно: разрешённые Telegram ID через запятую; /id покажет ваш ID.
# Пустое значение разрешает демо всем, кто напишет боту в личные сообщения.
TELEGRAM_ALLOWED_USER_IDS=
